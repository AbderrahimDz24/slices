### Sign in as ADMIN
# @name SignIn (Admin)
POST {{baseUrl}}/users/signin
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set("adminAccessToken", response.body.accessToken);
%}

### Create a REGULAR client user and wallet
# @name createClientUser
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "email": "{{clientEmail}}",
  "password": "{{clientPassword}}",
  "role": "REGULAR"
}

> {%
    client.global.set("clientUserId", response.body.id);
%}

### Create another ADMIN user
# @name createAdminUser
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "email": "admin-2@example.com",
  "password": "{{adminPassword}}",
  "role": "ADMIN"
}

### Sign in as client user
# @name SignIn (User)
POST {{baseUrl}}/users/signin
Content-Type: application/json

{
  "email": "{{clientEmail}}",
  "password": "{{clientPassword}}"
}

> {%
    client.global.set("clientAccessToken", response.body.accessToken);
%}

### Get balance
GET {{baseUrl}}/account
Authorization: Bearer {{clientAccessToken}}
Accept: application/json

### List active catalog offers with Bearer auth
# @name listOffersBearer
GET {{baseUrl}}/offers
Authorization: Bearer {{clientAccessToken}}
Accept: application/json

### Create API key
# @name createApiKey
POST {{baseUrl}}/account/api-keys
Authorization: Bearer {{clientAccessToken}}
Content-Type: application/json

{
  "name": "Scratch HTTP client"
}

> {%
    client.global.set("clientApiKey", response.body.apiKey);
    client.global.set("clientApiKeyId", response.body.id);
    client.global.set("clientApiKeyPreview", response.body.keyPreview);
%}

### List active API keys
GET {{baseUrl}}/account/api-keys
Authorization: Bearer {{clientAccessToken}}
Accept: application/json

### Get balance (API key)
GET {{baseUrl}}/account
Authorization: ApiKey {{clientApiKey}}
Accept: application/json

### List active catalog offers with API key
# @name listOffers (ApiKey)
GET {{baseUrl}}/offers
Authorization: ApiKey {{clientApiKey}}
Accept: application/json

### Deposit
POST {{baseUrl}}/admin/users/{{clientUserId}}/deposits
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "amount": 5000,
  "note": "Initial funding"
}

### Create confirmed mobile topup transaction
# @name createTopup
POST {{baseUrl}}/topups
Authorization: ApiKey {{clientApiKey}}
Content-Type: application/json

{
  "offerId": "off_mobilis__prepaid",
  "msisdn": "+213612345678",
  "amount": 1000,
  "externalId": "{{$random.uuid}}"
}

> {%
    client.global.set("transactionId", response.body.id);
    client.global.set("externalId", response.body.externalId);
%}

### Get topup by transaction ID
GET {{baseUrl}}/topups/{{transactionId}}
Authorization: ApiKey {{clientApiKey}}
Accept: application/json

### Get topup by external ID
GET {{baseUrl}}/topups/get-by-external-id?externalId={{externalId}}
Authorization: ApiKey {{clientApiKey}}
Accept: application/json

### Get balance after topup reservation
GET {{baseUrl}}/account
Authorization: ApiKey {{clientApiKey}}
Accept: application/json

### Revoke API key
DELETE {{baseUrl}}/account/api-keys/{{clientApiKeyId}}
Authorization: Bearer {{clientAccessToken}}
Accept: application/json
